# Persistent absolute paths outside the Actions checkout.
OCR_DATA_DIR=/srv/sir-ocr/data
OCR_MODEL_CACHE=/srv/sir-ocr/cache/paddlex
OCR_AUX_CACHE=/srv/sir-ocr/cache/aux
OCR_UID=1000
OCR_GID=1000
OCR_PORT=8096
# Trust only the immediate nginx and tunnel container IPs, never all clients.
# scripts/deploy.sh derives these live on sir-server.
OCR_TRUSTED_PROXIES=
OCR_IDLE_SECONDS=300
OCR_GPU_FREE_MIB=9216
OCR_DPI=200
